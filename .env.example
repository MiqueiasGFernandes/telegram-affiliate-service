# Copie para .env e substitua os valores ilustrativos antes de executar.
NODE_ENV=development
EXECUTION_MODE=once
SCHEDULE_CRON=0 9 * * *
SCHEDULE_TIMEZONE=America/Sao_Paulo
RUN_MAX_DURATION_MS=600000
LOG_LEVEL=info

PERSISTENCE_ENABLED=false
# Obrigatórios somente quando PERSISTENCE_ENABLED=true
DATABASE_URL=postgresql://user:password@localhost:5432/affiliate_research
DATABASE_SSL=false
DATABASE_POOL_MAX=5

AFFILIATE_CURRENCY=BRL
LOW_TICKET_MIN=20.00
LOW_TICKET_MAX=100.00
MEDIUM_TICKET_MIN=100.01
MEDIUM_TICKET_MAX=500.00
MIN_DISCOUNT_PERCENT=10
MELI_SITE_ID=MLB
MELI_CLIENT_ID=183092438794406
MELI_CLIENT_SECRET=lEVHRgUndAe9RwqGVZu66JnFVxBrWaqq
MELI_REFRESH_TOKEN=replace-me
MELI_HTTP_TIMEOUT_MS=10000
MELI_MAX_CONCURRENCY=4
MELI_MAX_RETRIES=3

AFFILIATE_EVIDENCE_MODE=manual-file
AFFILIATE_EVIDENCE_FILE=/absolute/path/to/affiliate-evidence.json
